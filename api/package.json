{
  "name": "saas-sms-calendar-api",
  "version": "1.0.0",
  "description": "Enterprise SaaS Platform - SMS Contact Center & Appointment Scheduling API",
  "main": "src/server.js",
  "scripts": {
    "prekill": "node kill-port.js 5000",
    "start": "npm run prekill && node src/server.js",
    "dev": "npm run prekill && nodemon src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "nodemon src/worker.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:unit": "jest --testPathPattern=tests/unit",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "seed": "node src/db/seeders/index.js"
  },
  "keywords": [
    "saas",
    "sms",
    "appointment",
    "scheduling",
    "twilio",
    "multi-tenant"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^164.1.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "http": "^0.0.1-security",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.4.4",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "rate-limit-redis": "^4.2.0",
    "slugify": "^1.6.6",
    "socket.io": "^4.6.1",
    "twilio": "^4.19.3",
    "util": "^0.12.5",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
